# 1Password secret references for calling the prod API. Safe to commit: these are pointers,
# not secrets. `op run --env-file op.env -- <command>` resolves them into env variables.
HELSINKI_API_URL="op://Private/helsinki-api-gateway-rest-api/api_url"
HELSINKI_CLIENT_ID="op://Private/helsinki-api-gateway-rest-api/client_id"
HELSINKI_CLIENT_SECRET="op://Private/helsinki-api-gateway-rest-api/client_secret"
